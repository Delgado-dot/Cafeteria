# ============================
# Django
# ============================
DJANGO_SECRET_KEY=tu-clave-secreta-segura-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# ============================
# Base de datos
# ============================
# Para SQLite (desarrollo)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para PostgreSQL (producción)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cafeteria_db
# DB_USER=cafeteria_user
# DB_PASSWORD=tu-contraseña
# DB_HOST=localhost
# DB_PORT=5432

# ============================
# CORS
# ============================
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# ============================
# Internacionalización
# ============================
DJANGO_LANGUAGE_CODE=es-ec
DJANGO_TIME_ZONE=America/Guayaquil

# ============================
# Email
# ============================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-app
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cafeteria INTESUD <no-reply@intesud.edu.ec>

# ============================
# Seguridad (producción)
# ============================
SECURE_SSL_REDIRECT=False
